(lambda #f
  ()
  (clause
    (n xs)
    #f
    (label
      loop
      (i s ys)
      (jump loop n '0 xs)
      (if (call (gref g$<$1$%b) i '0)
        (primcall cons s ys)
        (jump
          loop
          (call (gref g$-$2$%b) i '1)
          (call (gref g$+$3$%b) i s)
          (call (gref g$cdr$4$%b) ys))))))
