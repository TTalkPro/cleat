(lambda #f
  (clause
    (x y)
    #f
    (begin
      (call (gref g$cons$1$%b) x '1)
      (call (gref g$pair?$2$%b) x)
      (call (gref g$car$3$%b) x)
      (if (call (gref g$=$4$%b) '1 '1.0)
        (call (gref g$+$5$%b) '1 '2 x '3)
        (call (gref g$fx+$6$%b) '2147483647 '1))
      (call (gref g$fxdiv$7$%b) '7 '0)
      (call (gref g$fx+$8$Cuser) '1 '2)
      (primcall
        vector
        (call (gref g$fx+$9$%b) '1 '2)
        (call (gref g$bitwise-and$10$%b) '6 '3)
        (call (gref g$char-upcase$11$%b) '#\a)
        (call (gref g$vector-ref$12$%b) '#(a b) '1)
        (call (gref g$car$13$%b) '(1 2))
        (call (gref g$vector-length$14$%b) '#(1 2 3))
        (primcall $fx+ '1 '2)
        (primcall not '#f)
        (primcall null? '())
        (call (gref g$expt$15$%b) '2 '10)
        (call (gref g$string-ref$16$%b) '"abc" '1)))))
