(lambda #f
  (clause
    (xs)
    #f
    (let ((n (box '0)))
      (letrec ((f (lambda "f"
                    (clause
                      (y)
                      #f
                      (if (primcall null? y)
                        (unbox n)
                        (call g (primcall cdr y))))))
               (g (lambda "g"
                    (clause
                      (z)
                      #f
                      (begin
                        (set-box! n (primcall $fx+ (unbox n) '1))
                        (call f z))))))
        (call f xs)))))
