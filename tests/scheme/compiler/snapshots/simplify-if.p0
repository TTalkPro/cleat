(lambda #f
  (clause
    (x y a b z)
    #f
    (begin
      (set! z a)
      (primcall
        cons
        (if (primcall not (primcall pair? x))
          (if (primcall pair? x) (primcall car x) '2)
          '1)
        (primcall
          cons
          (if (if a b '#f) (if a (if b '3 '4) '5) '6)
          (primcall
            cons
            (if (if (primcall null? y) '#t '#f) '7 '8)
            (primcall
              cons
              (if (primcall null? y) '#t '#f)
              (primcall
                cons
                (if (primcall eq? x y) '9 '9)
                (if z (if z '10 '11) '12)))))))))
