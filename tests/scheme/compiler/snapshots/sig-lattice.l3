(lambda #f
  ()
  (clause
    (v)
    #f
    (let ((n (call (gref g$vector-length$1$%b) v))
          (p (primcall cons v '())))
      (primcall
        cons
        (primcall car p)
        (label
          loop
          (i acc)
          (jump loop '0 '0)
          (if (primcall $fx<? i n)
            (jump
              loop
              (primcall $fx+ i '1)
              (call
                (gref g$+$2$%b)
                acc
                (call (gref g$vector-length$1$%b) v)))
            acc))))))
