(lambda #f
  (clause
    (n)
    #f
    (call
      (letrec ((loop
                 (lambda "loop"
                   (clause
                     (x acc)
                     #f
                     (if (call (gref g$<$1$%b) x n)
                       (call
                         loop
                         (call (gref g$+$2$%b) x '1.0)
                         (call
                           (gref g$+$3$%b)
                           acc
                           (call (gref g$*$4$%b) x '0.5)))
                       (primcall
                         cons
                         acc
                         (call (gref g$/$5$%b) n '2)))))))
        loop)
      '0.0
      '0.0)))
