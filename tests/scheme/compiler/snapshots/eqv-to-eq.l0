(lambda #f
  (clause
    (x)
    #f
    (primcall
      vector
      (primcall eqv? x 'a)
      (primcall eqv? '#t x)
      (primcall eqv? x '())
      (primcall eqv? x '1.5)
      (primcall eqv? x '7)
      (primcall eqv? x '#\a)
      (if (call (gref g$memv$1$%b) x '(less more)) '1 '2)
      (if (call (gref g$memv$2$%b) x '(a 1.5 #\c)) '3 '4)
      (call (gref g$memv$3$%b) x '(a b)))))
