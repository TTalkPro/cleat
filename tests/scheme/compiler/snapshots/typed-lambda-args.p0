(lambda #f
  (clause
    (a b)
    #f
    (call
      (lambda #f
        (clause
          (x$typed y$typed)
          #f
          (let ((x (primcall $as-fixnum x$typed))
                (y (primcall $as-flonum y$typed)))
            (primcall cons (primcall $fx* x x) (primcall $fl* y y)))))
      a
      b)))
