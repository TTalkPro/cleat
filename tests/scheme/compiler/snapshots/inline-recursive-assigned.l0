(lambda #f
  (clause
    (n)
    #f
    (letrec ((fact
               (lambda "fact"
                 (clause
                   (k)
                   #f
                   (if (call (gref g$=$1$%b) k '0)
                     '1
                     (call
                       (gref g$*$2$%b)
                       k
                       (call fact (call (gref g$-$3$%b) k '1))))))))
      (let ((h (lambda #f (clause (z) #f (primcall cons z z)))))
        (begin
          (set! h (lambda #f (clause (y) #f y)))
          (primcall cons (call fact n) (call h n)))))))
