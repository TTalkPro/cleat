(lambda #f
  (clause
    (x)
    #f
    (primcall
      vector
      (primcall eq? x 'a)
      (primcall eq? '#t x)
      (primcall eq? x '())
      (primcall eqv? x '1.5)
      (primcall eqv? x '7)
      (primcall eqv? x '#\a)
      (if (if (primcall eq? x 'less) '#t (primcall eq? x 'more)) '1 '2)
      (if (if (primcall eq? x 'a)
            '#t
            (if (primcall eqv? x '1.5) '#t (primcall eqv? x '#\c)))
        '3
        '4)
      (call (gref g$memv$3$%b) x '(a b)))))
