(lambda #f
  (clause
    (q v i)
    #f
    (call
      (lambda #f
        (clause
          (a b)
          #f
          (begin
            (call (gref g$vector-set!$1$%b) v i a)
            (primcall
              cons
              (call (gref g$vector-ref$2$%b) v i)
              (if (primcall pair? q) b '#f)))))
      (primcall car q)
      (primcall cdr q))))
