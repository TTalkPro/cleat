(lambda #f
  (clause
    (l m w)
    #f
    (begin
      (if (call (gref g$list?$1$%b) l)
        (if (primcall null? l) '0 (primcall car l))
        '#f)
      (if (primcall pair? m)
        (if (primcall pair? m) (primcall cdr m) '#f)
        (call (gref g$vector?$2$%b) m))
      (if (primcall pair? w)
        (begin (set! w (primcall cdr w)) (primcall car w))
        '#f))))
