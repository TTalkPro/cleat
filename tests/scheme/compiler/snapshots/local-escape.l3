(lambda #f
  ()
  (clause
    (xs)
    #f
    (escape-frame
      k
      (label
        loop
        (l)
        (jump loop xs)
        (if (primcall pair? l)
          (begin
            (if (primcall null? (primcall car l)) (call k l) '#f)
            (jump loop (primcall cdr l)))
          '#f)))))
