(lambda #f
  (clause
    (v)
    #f
    (call
      (lambda #f
        (clause
          (n p)
          #f
          (primcall
            cons
            (primcall car p)
            (call
              (letrec ((loop
                         (lambda "loop"
                           (clause
                             (i acc)
                             #f
                             (if (primcall $fx<? i n)
                               (call
                                 loop
                                 (primcall $fx+ i '1)
                                 (call
                                   (gref g$+$2$%b)
                                   acc
                                   (call
                                     (gref g$vector-length$1$%b)
                                     v)))
                               acc)))))
                loop)
              '0
              '0))))
      (call (gref g$vector-length$1$%b) v)
      (primcall cons v '()))))
