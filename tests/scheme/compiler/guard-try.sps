;;; cleat-058：guard / try / catch / finally / throw / call-with-return 的端到端测试（移植自 skeg 的 host-smoke.sps，
;;; designs 见 skeg 13）。在镜像上以顶层程序运行。
(import (rnrs) (rnrs eval) (cleat scheme) (cleat scheme clr) (only (cleat scheme unsafe) $car))

(define failures 0)
(define checks 0)
(define-syntax check
  (syntax-rules ()
    ((_ expr expected)
     (let ((got (guard (e (#t (list 'exception (if (message-condition? e) (condition-message e) e)))) expr)))
       (set! checks (+ checks 1))
       (unless (equal? got expected)
         (set! failures (+ failures 1))
         (display "FAIL: ") (write 'expr) (display " => ") (write got) (display "  expected ") (write expected) (newline))))))

;; call-with-return：逃逸、一次性
(check (call-with-return (lambda (k) (+ 1 (k 42)))) 42)
(check (call-with-return (lambda (k) (try (k 'escaped) (finally #f)))) 'escaped)
(check (let ((log '())) (list (call-with-return (lambda (k) (try (k 'out) (finally (set! log (cons 'f log)))))) log)) '(out (f)))
(check (let ((saved #f)) (call-with-return (lambda (k) (set! saved k))) (guard (e ((assertion-violation? e) 'stale)) (saved 1))) 'stale)

;; guard：R6RS 语义
(check (guard (e ((assertion-violation? e) 'caught)) (vector-ref (vector 1) 5)) 'caught)
(check (guard (e ((symbol? e) (list 'caught e))) (raise 'boom)) '(caught boom))
(check (guard (o ((string? o) (list 'outer o))) (guard (i ((symbol? i) 'inner)) (raise "s"))) '(outer "s"))
(check (with-exception-handler (lambda (c) 10) (lambda () (guard (e ((string? e) 's)) (+ 1 (raise-continuable 'c))))) 11)
(check (with-exception-handler (lambda (c) (* c 2)) (lambda () (+ 1 (raise-continuable 20)))) 41)
(check (call-with-values (lambda () (guard (e (#t 0)) (values 1 2))) list) '(1 2))
(check (guard (e ((assq 'a e) => cdr) ((assq 'b e))) (raise (list (cons 'a 42)))) 42)
(check (guard (e (#t (list 'outer e))) (guard (e ((symbol? e) (raise (list 'wrapped e)))) (raise 'x))) '(outer (wrapped x)))
(check (guard (e ((non-continuable-violation? e) 'non-continuable)) (with-exception-handler (lambda (c) 'ignored) (lambda () (raise 'x)))) 'non-continuable)

;; 宿主异常 → &clr-exception 条件
(check (guard (e (((clr-exception-of? System.FormatException) e) 'format)) (clr-static-call System.Int32 Parse "zz")) 'format)
(check (guard (e ((error? e) (list (clr-condition? e) (condition-who e)))) (clr-static-call System.Int32 Parse "zz"))
       '(#t System.FormatException))
(check (guard (e ((clr-condition? e) (clr-is System.FormatException (clr-condition-exception e))))
         (clr-new System.Text.StringBuilder -1))
       #f)
(check (clr-guard [e ((clr-is System.FormatException e) 'clr-guard)] (clr-static-call System.Int32 Parse "zz")) 'clr-guard)
(check (guard (o (#t 'outer)) (guard (i ((symbol? i) 'inner)) (clr-static-call System.Int32 Parse "zz"))) 'outer)
(check (guard (e ((clr-condition? e) (condition-who e))) ($car 5)) 'System.InvalidCastException)

;; try：Clojure 式 catch（按 .NET 类型、书写顺序）与 finally
(check (let* ((log '())
              (r (try (clr-static-call System.Int32 Parse "zz")
                   (catch System.ArgumentException e 'arg)
                   (catch System.FormatException e 'format)
                   (finally (set! log (cons 'f log))))))
         (list r log))
       '(format (f)))
(check (let* ((log '())
              (r (guard (e (#t 'outer))
                   (try (clr-static-call System.Int32 Parse "zz")
                     (catch System.ArgumentException e 'arg)
                     (finally (set! log (cons 'f log)))))))
         (list r log))
       '(outer (f)))
(check (try 1 2 (finally 3)) 2)
(check (try 'only-body) 'only-body)
(check (call-with-values (lambda () (try (values 1 2) (catch System.Exception e 'no))) list) '(1 2))
(check (guard (e ((symbol? e) (list 'scheme e))) (try (raise 'sym) (catch System.Exception e 'clr))) '(scheme sym))
(check (let ((log '())) (guard (e (#t (set! log (cons 'handler log)))) (try (raise 'x) (finally (set! log (cons 'after log))))) log) '(handler after))

;; throw：直接映射为 .NET 的 throw
(define boom (clr-new System.InvalidOperationException "boom"))
(check (eq? boom (try (throw boom) (catch System.InvalidOperationException e e))) #t)
(check (guard (e ((clr-condition? e) (list (condition-who e) (condition-message e)))) (throw boom))
       '(System.InvalidOperationException "boom"))
(check (guard (e ((clr-condition? e) 'outer)) (try (throw boom) (catch System.ArgumentException e 'arg))) 'outer)
(check (guard (e (((clr-exception-of? System.InvalidOperationException) e) 'rethrown))
         (try (throw boom) (catch System.Exception e (throw e))))
       'rethrown)
(check (guard (e ((clr-condition? e) (eq? boom (clr-condition-exception e)))) (throw boom)) #t)
(check (let ((p (make-parameter 1)))
         (guard (e ((clr-condition? e) (p))) (parameterize ((p 2)) (throw boom))))
       1)

(display "guard-try: ") (display (- checks failures)) (display " of ") (display checks) (display " passed") (newline)
(unless (= failures 0) (exit 1))
