;;; 微基准：常用操作的每次耗时（iron-060）。手动运行，不进 dotnet test：
;;;   cd src/scheme && dotnet ../Cleat.Stage0/bin/Release/net10.0/stage0.dll -I lib -I nanopass --boot ../boot/cleat.scheme.boot.dll ../../tests/scheme/perf/micro-ops.sps
;;; 每项放在独立过程里（顶层方法超过 2000 个节点时编译器不内联算术，数字会偏大 4 倍）。
;;; Chez 对照版本是 micro-ops-chez.sps（scheme --optimize-level 2 --program …）。
(import (except (rnrs) define-record-type) (rnrs r5rs) (cleat scheme) (cleat scheme clr) (cleat scheme unsafe))
(define freq (clr-static-field-get System.Diagnostics.Stopwatch Frequency))
(define (now) (clr-static-call System.Diagnostics.Stopwatch GetTimestamp))
(define (report name t0 n)
  (let ((ns (/ (* (- (now) t0) 1e9) freq n)))
    (display name) (display ": ") (display (round ns)) (display " ns/iter") (newline)))
(define v (make-vector 100 1))
(define bv (make-bytevector 100 7))
(define s (make-string 100 #\a))
(define big (expt 10 2000))
(define big2 (expt 7 1500))
(define (id x) x)
(define p (make-parameter 1))
(define (h c) 0)
(define ht (make-eq-hashtable))
(define (rest . xs) xs)
(define sp (open-string-input-port (make-string 10000000 #\a)))
(define (bench0)
  (let ((t0 (now)))
    (let loop ((i 0) (r #f))
      (if (< i 10000000)
          (loop (+ i 1) i)
          (begin (report "empty loop" t0 10000000) r)))))
(bench0)
(define (bench1)
  (let ((t0 (now)))
    (let loop ((i 0) (r #f))
      (if (< i 10000000)
          (loop (+ i 1) (remainder 1000003 (+ i 1)))
          (begin (report "remainder" t0 10000000) r)))))
(bench1)
