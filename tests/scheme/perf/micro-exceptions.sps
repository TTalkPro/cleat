;;; 微基准：异常处理各环节的每次耗时（iron-060 / iron-063 / iron-065）。手动运行：
;;;   cd src/scheme && dotnet ../Cleat.Stage0/bin/Release/net10.0/stage0.dll -I lib -I nanopass --boot ../boot/cleat.scheme.boot.dll ../../tests/scheme/perf/micro-exceptions.sps
(import (rnrs) (cleat scheme) (cleat scheme clr) (cleat scheme unsafe))
(define freq (clr-static-field-get System.Diagnostics.Stopwatch Frequency))
(define (now) (clr-static-call System.Diagnostics.Stopwatch GetTimestamp))
(define (report name t0 n)
  (let ((ns (/ (* (- (now) t0) 1e9) freq n)))
    (display name) (display ": ") (display (round ns)) (display " ns/iter") (newline)))
(define-syntax defbench
  (syntax-rules ()
    ((_ name n i expr)
     (begin
       (define (run)
         (let ((t0 (now)))
           (let loop ((i 0) (r #f))
             (if (< i n) (loop (+ i 1) expr) (begin (report name t0 n) r)))))
       (run)))))
(define (h c) 0)
(define (thunk) 1)
(define hs ($current-handlers))
(defbench "$current-handlers" 10000000 i ($current-handlers))
(defbench "$set-current-handlers! same" 10000000 i ($set-current-handlers! hs))
(defbench "$set-current-handlers! cons" 1000000 i ($set-current-handlers! (cons h hs)))
(defbench "$try/finally" 10000000 i ($try/finally 1 2))
(defbench "with-clr-exception-handler" 1000000 i (with-clr-exception-handler h thunk))
(defbench "with-exception-handler" 1000000 i (with-exception-handler h thunk))
(defbench "call-with-return no-escape" 1000000 i (call-with-return (lambda (k) 1)))
(defbench "call-with-values" 10000000 i (call-with-values thunk (lambda (x) x)))
(defbench "guard no raise" 1000000 i (guard (e (#t 0)) 1))
(defbench "try no throw" 1000000 i (try 1 (catch System.Exception e 0)))
(defbench "try finally" 1000000 i (try 1 (finally 2)))
(defbench "clr throw+catch" 100000 i (try (throw (clr-new System.Exception "x")) (catch System.Exception e 0)))
(defbench "escape" 100000 i (call-with-return (lambda (k) (k 1))))
(defbench "raise + guard" 100000 i (guard (e (#t 0)) (raise 'x)))
(defbench "raise-continuable + handler" 100000 i (with-exception-handler (lambda (c) 0) (lambda () (raise-continuable 'x))))
