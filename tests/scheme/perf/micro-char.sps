;;; 微基准：字符分类与大小写映射的每次耗时（iron-072）。手动运行，不进 dotnet test：
;;;   cd src/scheme && dotnet ../Cleat.Stage0/bin/Release/net10.0/stage0.dll -I lib -I nanopass --boot ../boot/cleat.scheme.boot.dll ../../tests/scheme/perf/micro-char.sps
;;; 字符在 ASCII 与 BMP 中常见区段之间轮换（查表与 .NET 的快路径都会被走到）。
(import (rnrs) (cleat scheme) (cleat scheme clr))
(define freq (clr-static-field-get System.Diagnostics.Stopwatch Frequency))
(define (now) (clr-static-call System.Diagnostics.Stopwatch GetTimestamp))
(define (report name t0 n)
  (let ((ns (/ (* (- (now) t0) 1e9) freq n)))
    (display name) (display ": ") (display (round ns)) (display " ns/iter") (newline)))
(define chars (list->vector (map integer->char '(97 65 48 32 233 201 945 913 1103 20013 12354 8364 95 10 1488 65313))))
(define n 5000000)
(define-syntax bench
  (syntax-rules ()
    ((_ name f)
     (let ((t0 (now)))
       (let loop ((i 0) (r #f))
         (if (fx<? i n)
             (loop (fx+ i 1) (f (vector-ref chars (fxand i 15))))
             (begin (report name t0 n) r)))))))
(define (b0) (bench "identity" (lambda (c) c)))
(define (b1) (bench "char-alphabetic?" char-alphabetic?))
(define (b2) (bench "char-numeric?" char-numeric?))
(define (b3) (bench "char-whitespace?" char-whitespace?))
(define (b4) (bench "char-upper-case?" char-upper-case?))
(define (b5) (bench "char-upcase" char-upcase))
(define (b6) (bench "char-downcase" char-downcase))
(define (b7) (bench "char-foldcase" char-foldcase))
(define (b8) (bench "char-general-category" char-general-category))
(define (b9) (bench "char-ci=?" (lambda (c) (char-ci=? c #\a))))
(b0) (b1) (b2) (b3) (b4) (b5) (b6) (b7) (b8) (b9)
