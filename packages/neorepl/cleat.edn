;; The neorepl package as a cleat project (designs/18). It depends on the nrepl
;; package through NuGet: build and install that first (packages/nrepl), then
;;   cleat -T:build pack          ; target/Cleat.Neorepl.0.1.0.nupkg
;;   cleat -T:build install
;; (bin/neorepl runs both packages from source and does not use this file.)
{:paths ["src"]
 :deps {Cleat.Nrepl {:nuget/version "1.8.1"}
        ;; jack-in computes the server's load path with tools.build's create-basis
        Cleat.ToolsBuild {:nuget/version "0.10.17"}}}
