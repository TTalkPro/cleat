<Project Sdk="Microsoft.NET.Sdk">
  <!-- 命令行宿主与 REPL；Clojure 镜像的生成目标（cleat-181 / 182：编译器从源码两步编出，没有种子） -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cleat.Host</RootNamespace>
    <AssemblyName>cleat</AssemblyName>
    <!-- 自包含发布（cleat-034）在任何 Linux 发行版可跑：不用 ICU（运行时只用 InvariantCulture） -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cleat.Core\Cleat.Core.csproj" />
    <!-- 编译器（C#，designs/30）：Startup.EnsureCompiler 按程序集名 Cleat.Compiler 加载 -->
    <ProjectReference Include="..\Cleat.Compiler\Cleat.Compiler.csproj" />
  </ItemGroup>

  <!--
    dotnet tool 包 Cleat.Cli（cleat-071；tools/build.cs pack 用 -p:PackAsTool=true 打）：命令 cleat。镜像、随附库与
    tools.build / tools.namespace 的包程序集（src/boot/tools/，tools/build.cs pack 先编好）和宿主在同一目录，宿主按
    AppContext.BaseDirectory 找到它们。
  -->
  <PropertyGroup Condition="'$(PackAsTool)' == 'true'">
    <PackageId>Cleat.Cli</PackageId>
    <ToolCommandName>cleat</ToolCommandName>
    <Authors>cleat</Authors>
    <Description>cleat, Clojure on .NET: the command line (REPL, scripts, -m), with -M:alias and -T:build for projects (cleat.edn: NuGet deps via nuget.config, BaGetter included; tools.build bundled).</Description>
    <PackageLicenseExpression>EPL-1.0</PackageLicenseExpression>
    <!-- 打进包的镜像目录（cleat-177）：缺省 src/boot/；tools/build.cs pack 按 CLEAT_BOOT 传（如 image-set 编的 src/boot-cs/） -->
    <CleatPackBootDir Condition="'$(CleatPackBootDir)' == ''">$(MSBuildThisFileDirectory)..\boot\</CleatPackBootDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(PackAsTool)' == 'true'">
    <None Include="$(CleatPackBootDir)cleat.boot.dll;$(CleatPackBootDir)cleat.boot.pdb;$(CleatPackBootDir)cleat.boot.ifc;$(CleatPackBootDir)cleat.boot.inl;$(CleatPackBootDir)Cleat.Clojure.Libs.dll;$(CleatPackBootDir)Cleat.Clojure.Libs.pdb"
          Pack="true" PackagePath="tools/$(TargetFramework)/any/" Visible="false" />
    <None Include="$(CleatPackBootDir)tools\*.dll;$(CleatPackBootDir)tools\*.pdb" Pack="true" PackagePath="tools/$(TargetFramework)/any/tools/" Visible="false" />
  </ItemGroup>

  <!-- 行编辑器的词法函数（IsComplete 等）由 Host.Tests 单元测试 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Cleat.Host.Tests" />
  </ItemGroup>

  <!-- 镜像的生成：dotnet build -p:BuildBootImage=false 只编译 C# -->
  <PropertyGroup>
    <BuildBootImage Condition="'$(BuildBootImage)' == ''">true</BuildBootImage>
    <BootDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\boot'))</BootDir>
    <DotnetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</DotnetHost>
    <DotnetHost Condition="'$(DOTNET_HOST_PATH)' == ''">dotnet</DotnetHost>
  </PropertyGroup>

  <!--
    Clojure 镜像（cleat-053；cleat-181 起由 C# 编译器编，designs/30 D8）：两步——
      1. 宿主不加载任何镜像（命令行选项 no-boot），编译器按 src/boot/boot-order.edn 从 src/clojure 源码逐个加载 cleat.kernel、clojure.core
         及其余 boot 命名空间，编成 obj/cs-stage1/cleat.boot.dll（这一遍 core.clj 早期的几处 :inline 用不了：inliner 要的 concat 还没定义）；
      2. 在 stage1 上再编一遍成 src/boot/cleat.boot.{dll,pdb,ifc,inl}。编译器的输出与起步镜像无关（只要起步镜像是完整的），
         所以第二遍就是最终结果：从任何完整镜像起步都逐字节相同，两台机器、两个 .NET 补丁版本也相同。
    没有种子与自举（cleat-091 ~ 181 的 stage1 来自 Clojure 编译器的文本种子 src/boot/seed，cleat-182 删除）。按输入增量（约 12 秒）。
    -p:BuildBootImage=false 跳过。
  -->
  <PropertyGroup>
    <ClojureBootImage>$(BootDir)\cleat.boot.dll</ClojureBootImage>
    <ClojureSourceDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\clojure'))</ClojureSourceDir>
    <CsStage1Dir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)$(BaseIntermediateOutputPath)cs-stage1'))</CsStage1Dir>
  </PropertyGroup>
  <ItemGroup>
    <ClojureBootImageInput Include="$(ClojureSourceDir)\**\*.clj;$(ClojureSourceDir)\**\*.cljc;$(BootDir)\boot-order.edn" />
  </ItemGroup>
  <Target Name="GenerateBootImage" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(BuildBootImage)' == 'true'"
          Inputs="@(ClojureBootImageInput);$(TargetPath);$(OutDir)Cleat.Core.dll;$(OutDir)Cleat.Compiler.dll"
          Outputs="$(ClojureBootImage)">
    <Message Importance="high" Text="Cleat: compiling the Clojure boot image from src/clojure with the C# compiler (about 12 seconds) -> $(ClojureBootImage)" />
    <RemoveDir Directories="$(CsStage1Dir)" />
    <MakeDir Directories="$(CsStage1Dir)" />
    <Exec Command="&quot;$(DotnetHost)&quot; &quot;$(TargetPath)&quot; --no-boot -I &quot;$(ClojureSourceDir)&quot; --compile-boot &quot;$(CsStage1Dir)/cleat.boot.dll&quot; --boot-order &quot;$(BootDir)/boot-order.edn&quot;" />
    <Exec Command="&quot;$(DotnetHost)&quot; &quot;$(TargetPath)&quot; --boot &quot;$(CsStage1Dir)/cleat.boot.dll&quot; -I &quot;$(ClojureSourceDir)&quot; --compile-boot &quot;$(ClojureBootImage)&quot; --boot-order &quot;$(BootDir)/boot-order.edn&quot;" />
  </Target>

</Project>
