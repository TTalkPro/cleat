<Project Sdk="Microsoft.NET.Sdk">
  <!-- 命令行宿主与 REPL；Scheme 镜像、宿主库与 Clojure 镜像（GenerateBootImage，cleat-053）的生成目标 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cleat.Host</RootNamespace>
    <AssemblyName>cleat</AssemblyName>
    <!-- 自包含发布（cleat-034）在任何 Linux 发行版可跑：不用 ICU（运行时只用 InvariantCulture） -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cleat.Core\Cleat.Core.csproj" />
    <ProjectReference Include="..\Cleat.Emit\Cleat.Emit.csproj" />
    <ProjectReference Include="..\Cleat.Stage0\Cleat.Stage0.csproj" />
    <!-- 只为构建顺序：生成 Scheme 镜像前先由 PrimGen 重生成原语表 src/scheme/boot/primitives.ss（不引用其程序集） -->
    <ProjectReference Include="..\Cleat.PrimGen\Cleat.PrimGen.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    dotnet tool 包 Cleat.Cli（cleat-071；tools/build.cs pack 用 -p:PackAsTool=true 打）：命令 cleat。镜像、驱动库、随附库与
    tools.build / tools.namespace 的包程序集（src/boot/tools/，tools/build.cs pack 先编好）和宿主在同一目录，宿主按
    AppContext.BaseDirectory 找到它们。
  -->
  <PropertyGroup Condition="'$(PackAsTool)' == 'true'">
    <PackageId>Cleat.Cli</PackageId>
    <ToolCommandName>cleat</ToolCommandName>
    <Authors>cleat</Authors>
    <Description>cleat, Clojure on .NET: the command line (REPL, scripts, -m), with -M:alias and -T:build for projects (cleat.edn: NuGet deps via nuget.config, BaGetter included; tools.build bundled).</Description>
    <PackageLicenseExpression>EPL-1.0</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup Condition="'$(PackAsTool)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)..\boot\cleat.scheme.boot.dll;$(MSBuildThisFileDirectory)..\boot\cleat.scheme.boot.ifc;$(MSBuildThisFileDirectory)..\boot\cleat.boot.dll;$(MSBuildThisFileDirectory)..\boot\cleat.boot.ifc;$(MSBuildThisFileDirectory)..\boot\cleat.boot.inl;$(MSBuildThisFileDirectory)..\boot\Cleat.Clojure.Libs.dll"
          Pack="true" PackagePath="tools/$(TargetFramework)/any/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\boot\cleat.scheme.clojure\**\*" Pack="true"
          PackagePath="tools/$(TargetFramework)/any/cleat.scheme.clojure/%(RecursiveDir)" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\boot\tools\*.dll" Pack="true" PackagePath="tools/$(TargetFramework)/any/tools/" Visible="false" />
  </ItemGroup>

  <!-- 行编辑器的词法函数（IsComplete 等）由 Host.Tests 单元测试 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Cleat.Host.Tests" />
  </ItemGroup>

  <!--
    Scheme 元层的 boot 镜像（cleat-046；designs/15 §1，IronScheme designs/05-bootstrap.md §3 Phase A）：
    stage0 执行文本种子 src/scheme/boot/boot-seed.core，运行 boot/buildscript-nano.sps，
    用 Scheme 编译器（nanopass）编译出 src/boot/cleat.scheme.boot.{lcil,dll,ifc}。
    按输入增量：种子、构建脚本、原语表、boot 源码、lib（编译器、(cleat scheme clr)、nanopass 适配库）、nanopass 框架，
    以及 stage0 / Cleat.Scheme / Cleat.Core / cleat-emit 程序集都没变时跳过（生成一次约 45 秒）。
    dotnet build -p:BuildBootImage=false 只编译 C#。输出到其他目录（自举比对）用 tools/build.cs scheme-stage1 <目录>。
  -->
  <PropertyGroup>
    <BuildBootImage Condition="'$(BuildBootImage)' == ''">true</BuildBootImage>
    <SchemeDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\scheme'))</SchemeDir>
    <SchemeBootDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\boot'))</SchemeBootDir>
    <SchemeBootImage>$(SchemeBootDir)\cleat.scheme.boot.dll</SchemeBootImage>
    <Stage0Dir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Cleat.Stage0\bin\$(Configuration)\$(TargetFramework)'))</Stage0Dir>
    <DotnetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</DotnetHost>
    <DotnetHost Condition="'$(DOTNET_HOST_PATH)' == ''">dotnet</DotnetHost>
  </PropertyGroup>
  <ItemGroup>
    <SchemeBootImageInput Include="$(SchemeDir)\boot\boot-seed.core;$(SchemeDir)\boot\buildscript-nano.sps;$(SchemeDir)\boot\primitives.ss" />
    <SchemeBootImageInput Include="$(SchemeDir)\boot\**\*.sls" />
    <SchemeBootImageInput Include="$(SchemeDir)\lib\**\*.sls" />
    <SchemeBootImageInput Include="$(SchemeDir)\nanopass\nanopass.ss;$(SchemeDir)\nanopass\nanopass\**\*.ss;$(SchemeDir)\nanopass\nanopass\**\*.sls" />
    <SchemeBootImageInput Include="$(Stage0Dir)\stage0.dll;$(Stage0Dir)\Cleat.Scheme.dll;$(Stage0Dir)\Cleat.Core.dll;$(Stage0Dir)\cleat-emit.dll" />
  </ItemGroup>
  <Target Name="GenerateSchemeBootImage" BeforeTargets="CopyFilesToOutputDirectory" Condition="'$(BuildBootImage)' == 'true'"
          Inputs="@(SchemeBootImageInput)" Outputs="$(SchemeBootImage)">
    <Message Importance="high" Text="Cleat: generating the Scheme boot image with stage0 (about 45 seconds) -> $(SchemeBootImage)" />
    <Exec Command="&quot;$(DotnetHost)&quot; &quot;$(Stage0Dir)\stage0.dll&quot; -I lib -I nanopass boot/boot-seed.core boot/buildscript-nano.sps &quot;$(SchemeBootDir)&quot;"
          WorkingDirectory="$(SchemeDir)" />
  </Target>

  <!--
    宿主用的 Scheme 库（cleat-052）：镜像上运行 clojure/build-host.sps，把 (clojure driver) 与 (clojure compile) 连同依赖（编译器、nanopass）
    预编译成 src/boot/cleat.scheme.clojure/ 下的 fasl 与清单 cleat-host.manifest；宿主启动时装入，不必从源码展开（约 10 秒 → 0.x 秒）。
    镜像或这些库的源码变了就重新生成（约 20 秒）。
  -->
  <PropertyGroup>
    <ClojureHostLibDir>$(SchemeBootDir)\cleat.scheme.clojure</ClojureHostLibDir>
  </PropertyGroup>
  <ItemGroup>
    <ClojureHostLibInput Include="$(SchemeBootImage)" />
    <ClojureHostLibInput Include="$(SchemeDir)\clojure\*.sls;$(SchemeDir)\clojure\*.sps" />
    <ClojureHostLibInput Include="$(SchemeDir)\lib\**\*.sls" />
    <ClojureHostLibInput Include="$(SchemeDir)\nanopass\nanopass.ss;$(SchemeDir)\nanopass\nanopass\**\*.ss;$(SchemeDir)\nanopass\nanopass\**\*.sls" />
  </ItemGroup>
  <Target Name="GenerateClojureHostLibraries" AfterTargets="GenerateSchemeBootImage" BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(BuildBootImage)' == 'true'"
          Inputs="@(ClojureHostLibInput)" Outputs="$(ClojureHostLibDir)\cleat-host.manifest">
    <Message Importance="high" Text="Cleat: precompiling the Clojure driver's Scheme libraries (about 20 seconds) -> $(ClojureHostLibDir)" />
    <MakeDir Directories="$(ClojureHostLibDir)" />
    <Exec Command="&quot;$(DotnetHost)&quot; &quot;$(Stage0Dir)\stage0.dll&quot; -I lib -I nanopass --boot &quot;$(SchemeBootImage)&quot; clojure/build-host.sps &quot;$(ClojureHostLibDir)&quot;"
          WorkingDirectory="$(SchemeDir)" />
  </Target>

  <!--
    Clojure 镜像（cleat-053；designs/08 §3 第二段）：宿主不加载已有的 Clojure 镜像（no-boot），按 src/boot/boot-order.edn 从
    src/clojure 源码加载 cleat.kernel、clojure.core 及其余 boot 命名空间（每个形式展开、编译、求值），把全部顶层形式编成一个
    程序集 src/boot/cleat.boot.{dll,lcil,ifc}。宿主启动时自动加载它（Loader.LoadBootImage）。
    按输入增量：Clojure 源码、boot-order.edn、Scheme 镜像与宿主库、宿主及其依赖程序集（约 20 秒）。-p:BuildBootImage=false 跳过。
  -->
  <PropertyGroup>
    <ClojureBootImage>$(SchemeBootDir)\cleat.boot.dll</ClojureBootImage>
    <ClojureSourceDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\clojure'))</ClojureSourceDir>
  </PropertyGroup>
  <ItemGroup>
    <ClojureBootImageInput Include="$(ClojureSourceDir)\**\*.clj;$(ClojureSourceDir)\**\*.cljc;$(SchemeBootDir)\boot-order.edn"
                           Exclude="$(ClojureSourceDir)\cleat\nanopass.clj;$(ClojureSourceDir)\cleat\nanopass\**;$(ClojureSourceDir)\cleat\compiler\**" />
    <ClojureBootImageInput Include="$(SchemeBootImage);$(ClojureHostLibDir)\cleat-host.manifest" />
  </ItemGroup>
  <Target Name="GenerateBootImage" AfterTargets="CopyFilesToOutputDirectory" Condition="'$(BuildBootImage)' == 'true'"
          Inputs="@(ClojureBootImageInput);$(TargetPath);$(OutDir)Cleat.Core.dll;$(OutDir)Cleat.Scheme.dll;$(OutDir)cleat-emit.dll"
          Outputs="$(ClojureBootImage)">
    <Message Importance="high" Text="Cleat: compiling the Clojure boot image from src/clojure (about 20 seconds) -> $(ClojureBootImage)" />
    <Exec Command="&quot;$(DotnetHost)&quot; &quot;$(TargetPath)&quot; --scheme-boot &quot;$(SchemeBootImage)&quot; --no-boot -I &quot;$(ClojureSourceDir)&quot; --compile-boot &quot;$(ClojureBootImage)&quot;" />
  </Target>

  <!--
    Clojure 编译器的包程序集（cleat-085；designs/19 D6）：现役的 Scheme 编译器把 src/clojure/cleat/nanopass*.clj 与 src/clojure/cleat/compiler/
    编成 src/boot/cleat.compiler.dll（入口 cleat.compiler.all），宿主登记进包索引，第一次 require 时才加载。
    按输入增量：这些源码、Clojure 镜像、宿主及其依赖程序集（约 20 秒）。也可以 tools/build.cs compile-compiler。
  -->
  <PropertyGroup>
    <CompilerPackage>$(SchemeBootDir)\cleat.compiler.dll</CompilerPackage>
  </PropertyGroup>
  <ItemGroup>
    <CompilerPackageInput Include="$(ClojureSourceDir)\cleat\nanopass.clj;$(ClojureSourceDir)\cleat\nanopass\**\*.clj;$(ClojureSourceDir)\cleat\compiler\**\*.clj" />
  </ItemGroup>
  <Target Name="GenerateCompilerPackage" AfterTargets="GenerateBootImage" Condition="'$(BuildBootImage)' == 'true'"
          Inputs="@(CompilerPackageInput);$(ClojureBootImage);$(TargetPath);$(OutDir)Cleat.Core.dll;$(OutDir)Cleat.Scheme.dll;$(OutDir)cleat-emit.dll"
          Outputs="$(CompilerPackage)">
    <Message Importance="high" Text="Cleat: compiling the Clojure compiler package (about 20 seconds) -> $(CompilerPackage)" />
    <Exec Command="&quot;$(DotnetHost)&quot; &quot;$(TargetPath)&quot; -I &quot;$(ClojureSourceDir)&quot; --compile-package &quot;$(CompilerPackage)&quot; --package cleat.compiler --root &quot;$(ClojureSourceDir)/cleat/nanopass.clj&quot; --root &quot;$(ClojureSourceDir)/cleat/nanopass&quot; --root &quot;$(ClojureSourceDir)/cleat/compiler&quot; cleat.compiler.all" />
  </Target>
</Project>
