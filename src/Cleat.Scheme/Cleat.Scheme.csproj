<Project Sdk="Microsoft.NET.Sdk">
  <!-- Scheme 元层运行时（designs/15 §1）：从 IronScheme（BSD）的 IronScheme.Core 纳入并更名，见 README.md。
       引用 Cleat.Core 只为 CleatModuleAttribute（模块入口约定）与 fasl 读回 Clojure 数据；Cleat.Core 不引用本项目。 -->
  <PropertyGroup>
    <RootNamespace>Cleat.Scheme</RootNamespace>
    <AssemblyName>Cleat.Scheme</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 从旧代码移植的类型带 CLSCompliant 标注 -->
    <NoWarn>$(NoWarn);CS3021</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cleat.Core\Cleat.Core.csproj" />
  </ItemGroup>
</Project>
