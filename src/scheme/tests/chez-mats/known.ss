;;; 已知差异（skeg iron-072；cleat-077 起按 cleat 的结果生成）：(文件 mat名字 子句号 原因)；子句号为 * 表示整个 mat。运行器不运行这些子句，计入 known。
;;; 原因分类：
;;;   chez-ext       依赖 Chez 对 R6RS 的扩展或 Chez 特有行为（R6RS 未规定，或规定为"应当报错"而 Chez 给出结果）
;;;   hang           cleat 上不终止（R6RS 未要求终止的用法）；运行器会按超时处理，登记只是省去重启
;;;   fixnum-width   cleat 的 fixnum 是 32 位，Chez 64 位机器上是 61 位
;;;   cleat-lax      cleat 少做的检查或精度（R6RS 未强制）
;;;   cleat-bug      cleat 的缺陷，待修
;;; 本文件由 mkknown.py 从对拍日志生成（规则在该脚本里），手工增删请保持格式。

;; —— 3.ms ——
("3.ms" cpvalid 5 "cleat-lax: letrec / letrec* 初始化前引用或赋值未检测（Chez 的 cpvalid pass），R6RS 只说\"应当\"报错")
("3.ms" cpvalid 6 "cleat-lax: letrec / letrec* 初始化前引用或赋值未检测（Chez 的 cpvalid pass），R6RS 只说\"应当\"报错")
("3.ms" cpvalid 7 "cleat-lax: letrec / letrec* 初始化前引用或赋值未检测（Chez 的 cpvalid pass），R6RS 只说\"应当\"报错")
("3.ms" cpvalid 11 "cleat-lax: letrec / letrec* 初始化前引用或赋值未检测（Chez 的 cpvalid pass），R6RS 只说\"应当\"报错")
("3.ms" cpvalid 34 "chez-ext: with-output-to-file 的 'replace 选项、expand/optimize 等 Chez 工具链形式")
("3.ms" define-values 27 "cleat-bug: define-values 的重复标识符未报语法错误")
("3.ms" define-values 28 "cleat-bug: define-values 的重复标识符未报语法错误")

;; —— 4.ms ——
("4.ms" cond 5 "cleat-bug: cond 的 => 接收者是宏关键字时应报语法错误（展开器把它当过程调用展开）")
("4.ms" exclusive-cond 7 "chez-ext: with-output-to-file 的 'replace 选项、expand/optimize 等 Chez 工具链形式")
("4.ms" case 8 "chez-ext: case 用 equal? 比较键（R6RS 为 eqv?）")
("4.ms" case 12 "chez-ext: with-output-to-file 的 'replace 选项、expand/optimize 等 Chez 工具链形式")
("4.ms" case 13 "chez-ext: 读回 Chez 工具链写出的 testfile.ss")
("4.ms" $primitive 4 "chez-ext: $primitive / #% 记法")
("4.ms" $primitive 5 "chez-ext: $primitive / #% 记法")
("4.ms" $primitive 6 "chez-ext: $primitive / #% 记法")

