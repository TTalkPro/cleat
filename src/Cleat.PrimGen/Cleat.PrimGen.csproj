<Project Sdk="Microsoft.NET.Sdk">
  <!-- 反射 Cleat.Scheme 的 [Primitive] 与 Cleat.Core 的 Primitives.Table，生成 src/scheme/boot/primitives.ss（Scheme 编译器读，cleat-046 起放在 Scheme 源码旁）与 primitives.edn（cleat-011 / cleat-045） -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cleat.PrimGen</RootNamespace>
    <AssemblyName>primgen</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cleat.Core\Cleat.Core.csproj" />
    <ProjectReference Include="..\Cleat.Scheme\Cleat.Scheme.csproj" />
  </ItemGroup>
  <!-- 构建后生成 src/boot/primitives.edn 与 src/scheme/boot/primitives.ss（内容不变时不写文件） -->
  <Target Name="GeneratePrimitives" AfterTargets="Build" Condition="'$(GeneratePrimitives)' != 'false'">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; &quot;$(MSBuildThisFileDirectory)../boot/primitives.edn&quot; &quot;$(MSBuildThisFileDirectory)../scheme/boot/primitives.ss&quot;" />
  </Target>
</Project>
