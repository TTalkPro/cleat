<Project Sdk="Microsoft.NET.Sdk">
  <!-- C# 程序嵌入 cleat 的入口（cleat-035，IronScheme designs/07 §5 的 Hosting 对应物）：初始化镜像与编译器、
       求值源码、require 命名空间、取 Var 调用。启动走 Cleat.Core.Runtime.Startup（宿主 cleat 也走它），不引用宿主程序集；
       引用 Cleat.Compiler 是为了把编译器带到输出目录（Startup 按程序集名加载它；cleat-182 之前这里引用的是发射器 Cleat.Emit）。 -->
  <PropertyGroup>
    <RootNamespace>Cleat.Core.Hosting</RootNamespace>
    <AssemblyName>Cleat.Hosting</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cleat.Core\Cleat.Core.csproj" />
    <ProjectReference Include="..\Cleat.Compiler\Cleat.Compiler.csproj" />
  </ItemGroup>
</Project>
