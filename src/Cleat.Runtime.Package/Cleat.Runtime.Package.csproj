<Project Sdk="Microsoft.NET.Sdk">
  <!-- cleat 运行时的 NuGet 包 Cleat.Runtime（cleat-067，designs/17 §3）：没有自己的代码，只打包（项目因此叫 Cleat.Runtime.Package；运行时代码在 Cleat.Core）。
       lib/net10.0/：Cleat.Core、Cleat.Hosting 与发射器 cleat-emit 程序集（不含命令行宿主 cleat）；
       runtime/：Clojure 镜像（与接口文件、内联体）、编译器包 cleat.compiler.dll、随附库的包程序集，经
       buildTransitive/Cleat.Runtime.targets 复制到引用方的输出目录（运行时按 AppContext.BaseDirectory 找到它们）。
       先 dotnet build（生成镜像）与 tools/build.cs compile-libs；tools/build.cs pack 按这个顺序做。 -->
  <PropertyGroup>
    <PackageId>Cleat.Runtime</PackageId>
    <Version Condition="'$(Version)' == ''">1.1.0</Version>
    <Authors>cleat</Authors>
    <Description>The cleat runtime: Clojure on .NET. Reference it (with cleat package assemblies) to use Clojure code from C# and F#; the runtime starts on first use.</Description>
    <PackageLicenseExpression>EPL-1.0</PackageLicenseExpression>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CleatRuntimeAssemblies</TargetsForTfmSpecificContentInPackage>
    <!-- 程序集放在 lib/ 而不是作为依赖包；runtime/ 不是约定目录 -->
    <NoWarn>$(NoWarn);NU5100;NU5128;NU5118</NoWarn>
    <BootDir>$(MSBuildThisFileDirectory)..\boot\</BootDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cleat.Hosting\Cleat.Hosting.csproj" PrivateAssets="all" />
    <!-- Cleat.Core 的 NuGet 依赖要写进包的依赖 -->
    <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="10.0.0" />
  </ItemGroup>

  <Target Name="CleatRuntimeAssemblies" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(ReferenceCopyLocalPaths)" PackagePath="lib/$(TargetFramework)/"
                              Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="buildTransitive\Cleat.Runtime.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="$(BootDir)cleat.boot.dll;$(BootDir)cleat.boot.ifc;$(BootDir)cleat.boot.inl;$(BootDir)cleat.compiler.dll;$(BootDir)Cleat.Clojure.Libs.dll"
          Pack="true" PackagePath="runtime\" Visible="false" />
  </ItemGroup>
</Project>
