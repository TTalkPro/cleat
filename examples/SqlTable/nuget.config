<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft.Data.Sqlite and its dependencies from nuget.org; cleat's own packages (the Cleat.Cli tool,
     Cleat.Neorepl …) from the self-hosted BaGetter. -->
<configuration>
  <packageSources>
    <clear />
    <add key="bagetter" value="http://localhost:5000/v3/index.json" allowInsecureConnections="true" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="bagetter">
      <package pattern="Cleat.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
