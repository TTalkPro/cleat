<?xml version="1.0" encoding="utf-8"?>
<!-- Where the example's packages come from: the self-hosted BaGetter (Cleat.Runtime, Cleat.Nrepl,
     Cleat.Neorepl, Cleat.ToolsBuild, ... pushed there with tools.build's push), then nuget.org for
     everything else. Both dotnet restore (the host) and cleat's create-basis (cleat.edn's :deps) read
     this file. -->
<configuration>
  <packageSources>
    <clear />
    <add key="bagetter" value="http://localhost:5000/v3/index.json" allowInsecureConnections="true" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="bagetter">
      <package pattern="Cleat.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
