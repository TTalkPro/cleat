<Project>
  <!-- The example is a standalone project: this file stops MSBuild from picking up the cleat
       repository's Directory.Build.props. CleatCommand is how the host's build runs cleat to compile
       the Clojure code: the local dotnet tool Cleat.Cli (.config/dotnet-tools.json, `dotnet tool
       restore`), or, when the example sits inside the cleat repository, the cleat built there.
       Override with -p:CleatCommand=... (e.g. cleat, for a global install). -->
  <PropertyGroup>
    <CleatRepo>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</CleatRepo>
    <CleatCommand Condition="'$(CleatCommand)' == '' and Exists('$(CleatRepo)src/Cleat.Host/bin/Release/net10.0/cleat')">"$(CleatRepo)src/Cleat.Host/bin/Release/net10.0/cleat"</CleatCommand>
    <CleatCommand Condition="'$(CleatCommand)' == ''">dotnet cleat</CleatCommand>
  </PropertyGroup>
</Project>
